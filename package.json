{
  "name": "skillbridge",
  "private": true,
  "version": "1.0.0",
  "description": "SkillBridge \u2014 a dynamic Skill library manager for LM Arena, packaged as a Chrome MV3 extension.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:ui && npm run build:targets",
    "build:ui": "vite build",
    "build:targets": "node scripts/build-targets.mjs",
    "build:all": "npm run build:ui && npm run build:targets",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run test && npm run build && npm run package:zip",
    "package:zip": "node scripts/package.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "serve:preview": "vite --host 0.0.0.0 --port 5173"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.0.330",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=20.19"
  }
}
